# PayBot Next.js route-handler example — copy to .env.local. NEVER commit secrets.

# Provider side: merchant wallet that receives payment on /api/premium.
PAYBOT_PAY_TO=0x0000000000000000000000000000000000000000

# Optional: self-hosted facilitator. Defaults to https://api.paybotcore.com.
# PAYBOT_FACILITATOR_URL=http://localhost:8787

# Consumer side (only if you use createX402Handler to call the route):
# PAYBOT_API_KEY=pb_test_xxxxxxxxxxxxxxxx
# WALLET_PRIVATE_KEY=0xabc...
