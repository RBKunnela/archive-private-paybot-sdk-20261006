# PayBot fastapi-bot example — copy to .env. NEVER commit your real .env.

# Required: your PayBot API key.
PAYBOT_API_KEY=pb_test_xxxxxxxxxxxxxxxx

# Stable bot id.
PAYBOT_BOT_ID=fastapi-bot

# Merchant wallet that receives payment on the gated /premium route.
PAYBOT_PAY_TO=0x0000000000000000000000000000000000000000

# Optional: enables real EIP-3009 signing. Omit for mock mode.
# WALLET_PRIVATE_KEY=0xabc...

# Optional: self-hosted facilitator. Defaults to https://api.paybotcore.com.
# PAYBOT_FACILITATOR_URL=http://localhost:8787
