# PayBot raw-node-script example — copy to .env and fill in.
# NEVER commit your real .env.

# Required: your PayBot API key (shown only once at signup).
PAYBOT_API_KEY=pb_test_xxxxxxxxxxxxxxxx

# A stable id for this bot.
PAYBOT_BOT_ID=smoke-bot

# Recipient wallet address for the test payment.
PAYBOT_PAY_TO=0x0000000000000000000000000000000000000000

# Optional: enables real EIP-3009 on-chain signing. Omit for mock mode.
# WALLET_PRIVATE_KEY=0xabc...

# Optional: point at a self-hosted facilitator. Defaults to https://api.paybotcore.com.
# PAYBOT_FACILITATOR_URL=http://localhost:8787
