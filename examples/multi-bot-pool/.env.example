# PayBot multi-bot-pool example — copy to .env. NEVER commit your real .env.

# Required: operator API key shared by all bots in the pool.
PAYBOT_API_KEY=pb_test_xxxxxxxxxxxxxxxx

# Recipient wallet for the demo payments.
PAYBOT_PAY_TO=0x0000000000000000000000000000000000000000

# Optional: per-bot signing keys (real mode). Omit for mock mode.
# BOT_A_WALLET_KEY=0xaaa...
# BOT_B_WALLET_KEY=0xbbb...

# Optional: self-hosted facilitator. Defaults to https://api.paybotcore.com.
# PAYBOT_FACILITATOR_URL=http://localhost:8787
