# PayBot express-bot example — copy to .env and fill in. NEVER commit your real .env.

# Required: your PayBot API key.
PAYBOT_API_KEY=pb_test_xxxxxxxxxxxxxxxx

# Stable bot id for the consumer side.
PAYBOT_BOT_ID=express-bot

# Your merchant wallet — receives payments on the gated /api/premium route.
PAYBOT_PAY_TO=0x0000000000000000000000000000000000000000

# Optional: enables real EIP-3009 signing on the /buy consumer route.
# WALLET_PRIVATE_KEY=0xabc...

# Optional: self-hosted facilitator. Defaults to https://api.paybotcore.com.
# PAYBOT_FACILITATOR_URL=http://localhost:8787

# Optional: HTTP port (default 3000).
# PORT=3000
