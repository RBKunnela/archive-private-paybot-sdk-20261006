# PayBot Hono/Cloudflare example.
#
# In production, secrets are set via wrangler, NOT a .env file:
#   wrangler secret put PAYBOT_PAY_TO
#   wrangler secret put PAYBOT_FACILITATOR_URL   # optional
#
# For local `wrangler dev`, copy this file to `.dev.vars` (gitignored) — wrangler
# loads .dev.vars as the Worker env automatically.

# Merchant wallet that receives payment on /api/premium.
PAYBOT_PAY_TO=0x0000000000000000000000000000000000000000

# Optional: self-hosted facilitator. Defaults to https://api.paybotcore.com.
# PAYBOT_FACILITATOR_URL=http://localhost:8787
