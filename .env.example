# PayBot SDK — environment configuration
#
# Copy this file to `.env` and replace the placeholder values. `.env` is
# gitignored and MUST NOT be committed; this example file ships only variable
# names, placeholders, and one-line descriptions.
#
# These variables configure the bundled CLI. When using the SDK
# programmatically, prefer passing options to `new PayBotClient({ apiKey,
# botId, facilitatorUrl, walletPrivateKey })` — constructor options take
# precedence over the environment.
#
# Mock mode: omit WALLET_PRIVATE_KEY and the client operates without a wallet;
# payment calls run in mock mode rather than signing on-chain transactions.

# PayBot API key. Required. (CLI: or pass --api-key)
PAYBOT_API_KEY=your-paybot-api-key

# Bot identifier. Required for the CLI. (CLI: or pass --bot-id)
PAYBOT_BOT_ID=your-bot-id

# Wallet private key for on-chain payments. Optional; omit for mock mode.
WALLET_PRIVATE_KEY=your-wallet-private-key

# Facilitator base URL. Optional; defaults to the PayBot-hosted facilitator.
PAYBOT_FACILITATOR_URL=https://api.paybotcore.com
